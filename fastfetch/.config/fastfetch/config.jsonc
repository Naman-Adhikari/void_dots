{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "display": {
        "separator": " : "
    },

    "logo": {
        "source": "~/.config/fastfetch/logo.png",
        "type": "auto",
        "width": 42,
        "height": 16,
        "padding": {
            "top": 3,
            "left": 3
        }
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "format": "       \u001b[38;5;22m░\u001b[38;5;28m▒\u001b[38;5;34m▓\u001b[38;5;40m█  SYSTEM MATRIX  █\u001b[38;5;34m▓\u001b[38;5;28m▒\u001b[38;5;22m░"
        },

        "break",

        {
            "type": "os",
            "key": "󰣇  OS",
            "keyColor": "#2f5e46",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "host",
            "key": "󰌢  HOST",
            "keyColor": "#3f7d5c",
            "outputColor": "#b7ffd0"
        },

        {
            "type": "kernel",
            "key": "  KERNEL",
            "keyColor": "#55a67a",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "uptime",
            "key": "󱎫  UPTIME",
            "keyColor": "#2f5e46",
            "outputColor": "#b7ffd0"
        },

        {
            "type": "packages",
            "key": "󰏖  PKGS",
            "keyColor": "#3f7d5c",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "shell",
            "key": "  SHELL",
            "keyColor": "#55a67a",
            "outputColor": "#b7ffd0"
        },

        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "#2f5e46",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "terminal",
            "key": "  TERM",
            "keyColor": "#3f7d5c",
            "outputColor": "#b7ffd0"
        },

        {
            "type": "cpu",
            "key": "󰻠  CPU",
			"format": "{name}",
            "keyColor": "#55a67a",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "gpu",
            "key": "󰢮  GPU",
            "keyColor": "#2f5e46",
            "outputColor": "#b7ffd0"
        },

        {
            "type": "memory",
            "key": "󰍛  RAM",
            "keyColor": "#3f7d5c",
            "outputColor": "#d8ffe8"
        },

        {
            "type": "disk",
            "key": "  DISK",
            "keyColor": "#55a67a",
            "outputColor": "#b7ffd0"
        },

        "break",

        {
            "type": "custom",
            "format": "       \u001b[38;5;42m[ VOID LINK ESTABLISHED ]"
        }
    ]
}
